# Copy to .env (gitignored). Compose reads this at the repo root.

# --- Database (TimescaleDB) ---
POSTGRES_USER=bellwether
POSTGRES_PASSWORD=bellwether
POSTGRES_DB=bellwether
DB_PORT=5432
# DSN used by the Python services and Prisma. For local (non-Docker) dev against
# the compose db, host is localhost; inside compose, services use host `db`.
DATABASE_URL=postgresql://bellwether:bellwether@localhost:5432/bellwether

# --- Dashboard / proxy ---
DASHBOARD_PORT=3000
# For the `proxy` compose profile (Caddy). Use a hostname for auto-HTTPS, or :80.
DASHBOARD_DOMAIN=:80
CADDY_BASIC_AUTH_USER=admin
# docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
CADDY_BASIC_AUTH_HASH=

# --- Polymarket ---
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
# Paid Polygon RPC for the on-chain OrderFilled V2 listener (Phase 2.2). Free
# public RPCs drop polls/events — use Alchemy/QuickNode.
POLYGON_RPC_URL=

# --- Kalshi (only for authenticated endpoints; public GetTrades needs none) ---
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# --- Manifold (no auth needed for reads) ---
MANIFOLD_API=https://api.manifold.markets
