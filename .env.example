# Kalshi (only required for authenticated endpoints — public GetTrades works without)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Polygon RPC for on-chain OrderFilled listener (optional; Data API path needs nothing)
POLYGON_RPC_URL=

# Polymarket — all endpoints below work unauthenticated for read-only use
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
